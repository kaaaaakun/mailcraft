{
  "name": "mailcraft",
  "version": "0.1.0",
  "description": "Open-source, embeddable drag & drop email editor (an Unlayer-style alternative).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/mailcraft.js",
  "module": "./dist/mailcraft.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "email",
    "editor",
    "drag-and-drop",
    "unlayer",
    "newsletter",
    "html-email"
  ],
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
